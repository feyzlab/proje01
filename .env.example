# Copy this file to .env.local and fill in the secrets.
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Sanity (public read)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID="ekt99equ"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"

# Server-only write token (seed + webhook setup). Never expose to the client.
SANITY_API_WRITE_TOKEN=""

# Shared secret for the ISR revalidate webhook:
#   https://<domain>/api/revalidate?secret=<SANITY_REVALIDATE_SECRET>
SANITY_REVALIDATE_SECRET=""

# Production origin used by `pnpm setup:webhook`
SITE_URL="https://proje01.com"

# ---------------------------------------------------------------------------
# Contact form (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="Proje 01 <forms@proje01.com>"
# First address = To, remaining (comma-separated) = Cc
CONTACT_TO_EMAIL="info@proje01.com"
